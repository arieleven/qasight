# Site facts for ./quickstart.sh. Copy to site.env and fill it in before you go in;
# nothing here is secret (the GitLab token is asked for when the script runs).

# Your GitLab and the project whose pipelines to record (group/name or its numeric id).
GITLAB_URL=https://gitlab.example.local
GITLAB_PROJECT=group/monorepo
# Only pipelines on this branch (empty: every branch).
GITLAB_BRANCH=
# The company CA (.pem) when GitLab's certificate is signed in-house (empty: none needed).
GITLAB_CA=

# How many past pipelines the first pass reads, and how often new ones are picked up.
BACKFILL_RUNS=300
SYNC_EVERY_MIN=15

# Where the team server lives on this machine, and its port.
SERVER_DIR=/opt/qasight-server
SERVER_PORT=8000
# Push the images to this registry first (empty: keep them in this machine's Docker).
REGISTRY=

# Optional: a model inside the network for failure summaries (empty: no AI).
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_S=120
