# Floating tag: each build picks up the Debian security fixes in the latest
# official image (the old 3.11.9 pin failed the CRITICAL Trivy scan). Dependabot
# (docker ecosystem) proposes newer Python tags; move every Dockerfile together.

FROM python:3.14-slim-trixie AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build
COPY pyproject.toml README.md ./
COPY qasight ./qasight

RUN python -m pip install --upgrade pip build && \
    python -m build --wheel --outdir /dist

FROM python:3.14-slim-trixie AS runtime

ARG TESTO_VERSION=dev
ARG TESTO_COMMIT_SHA=unknown
ARG TESTO_CREATED=unknown

LABEL org.opencontainers.image.title="qasight-runner" \
      org.opencontainers.image.description="Prebuilt runner image for QASight CI execution." \
      org.opencontainers.image.version="${TESTO_VERSION}" \
      org.opencontainers.image.revision="${TESTO_COMMIT_SHA}" \
      org.opencontainers.image.created="${TESTO_CREATED}"

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY --from=builder /dist/*.whl /tmp/
RUN WHEEL="$(ls /tmp/*.whl)" && python -m pip install "${WHEEL}[bdd]" && rm -rf /tmp/*.whl && \
    useradd --create-home --uid 10001 qasight && \
    chown qasight:qasight /workspace

USER qasight

ENTRYPOINT ["qasight"]
CMD ["run", "--help"]
